// MySL8TE Feature Lab - Database Schema
// Prisma Schema for PostgreSQL 16+

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole
  passwordHash String @map("password_hash")
  
  institutionId String @map("institution_id")
  institution   Institution @relation(fields: [institutionId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  teacherInCourses  CourseTeacher[]
  studentInCourses  CourseStudent[]
  submissions       Submission[]
  annotations       Annotation[]
  comments          Comment[]
  grades            Grade[]
  createdAssignments Assignment[]
  
  @@map("users")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

model Institution {
  id   String @id @default(uuid())
  name String
  domain String? @unique
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  users   User[]
  courses Course[]
  
  @@map("institutions")
}

// ============================================================================
// COURSE MANAGEMENT
// ============================================================================

model Course {
  id String @id @default(uuid())
  name String
  code String
  description String?
  
  institutionId String @map("institution_id")
  institution   Institution @relation(fields: [institutionId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  teachers    CourseTeacher[]
  students    CourseStudent[]
  assignments Assignment[]
  
  @@map("courses")
}

model CourseTeacher {
  id String @id @default(uuid())
  
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id])
  
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")
  
  @@unique([courseId, userId])
  @@map("course_teachers")
}

model CourseStudent {
  id String @id @default(uuid())
  
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id])
  
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])
  
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  
  @@unique([courseId, userId])
  @@map("course_students")
}

// ============================================================================
// ASSIGNMENT & SUBMISSION
// ============================================================================

model Assignment {
  id String @id @default(uuid())
  title String
  description String?
  
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id])
  
  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id])
  
  dueDate DateTime? @map("due_date")
  maxScore Float? @map("max_score")
  gradeType GradeType @default(POINTS) @map("grade_type")
  
  rubricId String? @map("rubric_id")
  rubric   Rubric? @relation(fields: [rubricId], references: [id])
  
  similarityCheckEnabled Boolean @default(false) @map("similarity_check_enabled")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  submissions Submission[]
  
  @@map("assignments")
}

enum GradeType {
  POINTS
  PERCENTAGE
  LETTER
  GPA
  COMPLETE_INCOMPLETE
  PASS_FAIL
}

model Submission {
  id String @id @default(uuid())
  
  assignmentId String @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  
  studentId String @map("student_id")
  student   User   @relation(fields: [studentId], references: [id])
  
  documentId String @map("document_id")
  document   Document @relation(fields: [documentId], references: [id])
  
  submittedAt DateTime @default(now()) @map("submitted_at")
  version Int @default(1)
  status SubmissionStatus @default(SUBMITTED)
  
  grade Grade?
  similarityReport SimilarityReport?
  annotations Annotation[]
  
  @@unique([assignmentId, studentId, version])
  @@map("submissions")
}

enum SubmissionStatus {
  SUBMITTED
  PROCESSING
  GRADED
  RETURNED
}

// ============================================================================
// DOCUMENT MANAGEMENT
// ============================================================================

model Document {
  id String @id @default(uuid())
  
  originalFilename String @map("original_filename")
  storedFilename   String @map("stored_filename")
  mimeType         String @map("mime_type")
  fileSize         Int    @map("file_size")
  format           DocumentFormat
  
  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")
  processingError  String?          @map("processing_error")
  
  previewUrl String? @map("preview_url")
  textContent String? @db.Text @map("text_content")
  pageCount Int? @map("page_count")
  metadata Json?
  
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  processedAt DateTime? @map("processed_at")
  
  submissions Submission[]
  annotations Annotation[]
  
  @@map("documents")
}

enum DocumentFormat {
  PDF
  DOCX
  DOC
  DOCM
  RTF
  ODT
  TXT
  MARKDOWN
  XLSX
  XLS
  ODS
  CSV
  PPTX
  PPT
  ODP
  PNG
  JPG
  JPEG
  WEBP
  TIFF
  BMP
  HEIC
  SVG
  OTHER
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================================
// ANNOTATION SYSTEM
// ============================================================================

model Annotation {
  id String @id @default(uuid())
  
  documentId String @map("document_id")
  document   Document @relation(fields: [documentId], references: [id])
  
  submissionId String @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id])
  
  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id])
  
  type AnnotationType
  page Int
  
  // Percentage-based coordinates (0-100)
  x      Float
  y      Float
  width  Float?
  height Float?
  
  content String? @db.Text // For text annotations
  color String?
  strokeData String? @db.Text // For drawings
  
  isDraft Boolean @default(true) @map("is_draft")
  publishedAt DateTime? @map("published_at")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  comments Comment[]
  
  @@map("annotations")
}

enum AnnotationType {
  POINT
  AREA
  HIGHLIGHT
  STRIKEOUT
  FREE_DRAW
  FREE_TEXT
}

model Comment {
  id String @id @default(uuid())
  
  annotationId String? @map("annotation_id")
  annotation   Annotation? @relation(fields: [annotationId], references: [id])
  
  submissionId String @map("submission_id")
  
  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id])
  
  content String @db.Text
  
  parentId String? @map("parent_id")
  parent   Comment? @relation("CommentThread", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentThread")
  
  isDraft Boolean @default(true) @map("is_draft")
  publishedAt DateTime? @map("published_at")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("comments")
}

// ============================================================================
// GRADING SYSTEM
// ============================================================================

model Grade {
  id String @id @default(uuid())
  
  submissionId String @unique @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id])
  
  gradedById String @map("graded_by_id")
  gradedBy   User   @relation(fields: [gradedById], references: [id])
  
  score Float
  maxScore Float @map("max_score")
  letterGrade String? @map("letter_grade")
  
  rubricScores Json? @map("rubric_scores") // {criterion_id: score}
  feedback String? @db.Text
  
  isDraft Boolean @default(true) @map("is_draft")
  publishedAt DateTime? @map("published_at")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("grades")
}

model Rubric {
  id String @id @default(uuid())
  title String
  description String?
  
  totalPoints Float @map("total_points")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  criteria RubricCriterion[]
  assignments Assignment[]
  
  @@map("rubrics")
}

model RubricCriterion {
  id String @id @default(uuid())
  
  rubricId String @map("rubric_id")
  rubric   Rubric @relation(fields: [rubricId], references: [id])
  
  title String
  description String?
  points Float
  order Int @default(0)
  
  ratings RubricRating[]
  
  @@map("rubric_criteria")
}

model RubricRating {
  id String @id @default(uuid())
  
  criterionId String @map("criterion_id")
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id])
  
  title String
  description String?
  points Float
  order Int @default(0)
  
  @@map("rubric_ratings")
}

// ============================================================================
// SIMILARITY DETECTION
// ============================================================================

model SimilarityReport {
  id String @id @default(uuid())
  
  submissionId String @unique @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id])
  
  overallSimilarity Float @map("overall_similarity") // 0-100
  status ProcessingStatus @default(PENDING)
  
  excludeQuotes Boolean @default(false) @map("exclude_quotes")
  excludeBibliography Boolean @default(false) @map("exclude_bibliography")
  excludeSmallMatches Boolean @default(false) @map("exclude_small_matches")
  smallMatchThreshold Int @default(8) @map("small_match_threshold") // words
  
  generatedAt DateTime @default(now()) @map("generated_at")
  
  sources SimilaritySource[]
  excludedMatches ExcludedMatch[]
  
  @@map("similarity_reports")
}

model SimilaritySource {
  id String @id @default(uuid())
  
  reportId String @map("report_id")
  report   SimilarityReport @relation(fields: [reportId], references: [id])
  
  sourceName String @map("source_name")
  sourceUrl String? @map("source_url")
  sourceType SourceType @map("source_type")
  
  similarityPercentage Float @map("similarity_percentage")
  
  passages SimilarityPassage[]
  
  @@map("similarity_sources")
}

enum SourceType {
  INTERNET
  PUBLICATION
  STUDENT_PAPER
}

model SimilarityPassage {
  id String @id @default(uuid())
  
  sourceId String @map("source_id")
  source   SimilaritySource @relation(fields: [sourceId], references: [id])
  
  submissionText String @db.Text @map("submission_text")
  sourceText String @db.Text @map("source_text")
  
  startPosition Int @map("start_position")
  endPosition Int @map("end_position")
  
  matchType MatchType @map("match_type")
  
  @@map("similarity_passages")
}

enum MatchType {
  EXACT
  NEAR_MATCH
}

model ExcludedMatch {
  id String @id @default(uuid())
  
  reportId String @map("report_id")
  report   SimilarityReport @relation(fields: [reportId], references: [id])
  
  text String @db.Text
  reason ExclusionReason
  
  excludedAt DateTime @default(now()) @map("excluded_at")
  
  @@map("excluded_matches")
}

enum ExclusionReason {
  QUOTE
  BIBLIOGRAPHY
  SMALL_MATCH
  MANUAL
}

// ============================================================================
// AUDIT & NOTIFICATIONS
// ============================================================================

model AuditLog {
  id String @id @default(uuid())
  
  userId String? @map("user_id")
  action String
  entity String
  entityId String @map("entity_id")
  changes Json?
  ipAddress String? @map("ip_address")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("audit_logs")
  @@index([userId])
  @@index([entity, entityId])
}

model Notification {
  id String @id @default(uuid())
  
  userId String @map("user_id")
  type NotificationType
  title String
  message String
  relatedEntity String? @map("related_entity")
  relatedEntityId String? @map("related_entity_id")
  
  read Boolean @default(false)
  readAt DateTime? @map("read_at")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("notifications")
  @@index([userId, read])
}

enum NotificationType {
  SUBMISSION_RECEIVED
  GRADE_PUBLISHED
  COMMENT_ADDED
  ASSIGNMENT_CREATED
  SIMILARITY_COMPLETE
}
