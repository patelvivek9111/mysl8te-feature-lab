# SQLite database file (created automatically). Use :memory: for ephemeral runs.
DATABASE_PATH=./data/feature-lab.sqlite

# Uploaded document storage directory
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=26214400

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Set to true only in local/test environments to enable POST /api/test/reset
ALLOW_TEST_RESET=false
