# Local PostgreSQL using the ubuntu peer socket. No password is stored here.
DATABASE_URL="postgresql://ubuntu@localhost/mysl8te_feature_lab?host=/var/run/postgresql&schema=public"
NODE_ENV=development
# Required when NODE_ENV=production. Development falls back to a local-only secret.
JWT_SECRET=replace-with-a-long-random-secret
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=26214400
PORT=3001
FRONTEND_URL=http://localhost:5173
SEED_ON_BOOT=true
