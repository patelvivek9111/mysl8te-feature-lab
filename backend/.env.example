# Local PostgreSQL using the ubuntu peer socket. No password is stored here.
DATABASE_URL="postgresql://ubuntu@localhost/mysl8te_feature_lab?host=/var/run/postgresql&schema=public"
NODE_ENV=development
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=26214400
PORT=3001
FRONTEND_URL=http://localhost:5173
# Resets the demo accounts' passwords on every boot. Never enable in production.
SEED_ON_BOOT=true
# Optional auth tuning (defaults shown).
# SESSION_TTL_MS=43200000
# SESSION_IDLE_MS=7200000
# LOGIN_WINDOW_MS=900000
# LOGIN_MAX_FAILURES=10
# LOGIN_MAX_FAILURES_PER_IP=50
# PASSWORD_CHANGE_MAX_FAILURES=5
# Express trust proxy: hop count, subnet list, true/false. Set it to match the reverse proxy in front of the API.
# TRUST_PROXY=loopback
