# Database Configuration

# PostgreSQL connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/mysl8te_feature_lab?schema=public"

# Node environment
NODE_ENV=development

# JWT secret (generate in production)
JWT_SECRET=your-secret-key-change-in-production

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# Server ports
PORT=3001
FRONTEND_URL=http://localhost:5173
