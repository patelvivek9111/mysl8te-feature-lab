{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend server for MySL8TE Feature Lab",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "node --import tsx --test --test-concurrency=1 src/extract.test.ts src/product.test.ts src/auth.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "eval:ai-writing": "tsx scripts/eval-ai-writing.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/multer": "^2.3.0",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "file-type": "^22.2.0",
    "multer": "^2.4.0",
    "prisma": "5.22.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^5.1.1"
  }
}
